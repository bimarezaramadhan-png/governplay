# Server Mode: "true" for local SQLite (recommended on Altare), "false" for PostgreSQL
OFFLINE_MODE=true

# Database connection string
# For SQLite (OFFLINE_MODE=true):
DATABASE_URL=file:./dev.db
# For PostgreSQL (OFFLINE_MODE=false):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: set to "true" to automatically run "prisma db push" on startup in PostgreSQL mode
# AUTO_DB_PUSH=true

# Admin console password (change this before deploying!)
ADMIN_PASSWORD=change_this_strong_password

# Allowed CORS origin ("*" or your domain e.g. https://tpa.yourdomain.com)
CORS_ORIGIN=*

# Port is automatically picked from SERVER_PORT (Altare/Pterodactyl) or PORT
# PORT=3000
